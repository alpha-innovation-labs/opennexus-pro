{
  "name": "opennexus",
  "private": true,
  "version": "0.2.22",
  "type": "module",
  "piConfig": {
    "name": "nexus",
    "configDir": ".nexus"
  },
  "scripts": {
    "generate:package-info": "node scripts/auto-update/generatePackageInfo.mjs",
    "generate:feature-flags": "npm run generate:package-info && node scripts/feature-flags/generateCompiledFeatureFlags.mjs && node scripts/feature-flags/generateCompiledBundledExtensions.mjs",
    "build:binary": "npm run generate:feature-flags && node scripts/release/buildBinaryBundle.mjs",
    "build:release": "npm run build:binary",
    "dev": "npm run generate:package-info && tsx -- apps/tui/src/index.ts",
    "dev-test": "npm run generate:package-info && NEXUS_DEV_TEST_MODE=1 tsx -- apps/tui/src/index.ts",
    "test": "node scripts/testing/runTests.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.43.0",
    "@earendil-works/pi-agent-core": "^0.78.0",
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0",
    "@ff-labs/fff-node": "^0.9.0",
    "@juicesharp/rpiv-i18n": "^1.17.1",
    "@modelcontextprotocol/ext-apps": "^1.7.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "^0.34.49",
    "@solana/web3.js": "^1.98.4",
    "@wterm/dom": "^0.3.0",
    "@xterm/headless": "^6.0.0",
    "better-result": "^2.9.2",
    "bip39": "^3.1.0",
    "cli-table3": "^0.6.5",
    "ed25519-hd-key": "^2.0.0",
    "jiti": "^2.7.0",
    "linkedom": "^0.18.12",
    "minimatch": "^10.2.5",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "p-limit": "^7.3.0",
    "pi-cursor-provider": "^0.1.11",
    "turndown": "^7.2.4",
    "typebox": "^1.1.39",
    "unpdf": "^1.6.2",
    "vscode-jsonrpc": "^9.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-unicode-sets-regex": "^7.29.7",
    "@marcfargas/pi-test-harness": "^0.6.1",
    "@schpet/linear-cli": "^2.0.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "javascript-obfuscator": "^5.4.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
