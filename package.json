{
  "name": "nexus-tui-awesome",
  "private": true,
  "version": "0.2.19",
  "type": "module",
  "piConfig": {
    "name": "nexus",
    "configDir": ".nexus"
  },
  "scripts": {
    "generate:feature-flags": "node scripts/feature-flags/generateCompiledFeatureFlags.mjs && node scripts/feature-flags/generateCompiledBundledExtensions.mjs",
    "build:binary": "npm run generate:feature-flags && node scripts/release/buildBinaryBundle.mjs",
    "build:release": "npm run build:binary",
    "dev": "tsx -- src/index.ts",
    "test": "node scripts/testing/runTests.mjs"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.6.4",
    "@mariozechner/pi-agent-core": "^0.70.0",
    "@mariozechner/pi-ai": "^0.70.0",
    "@mariozechner/pi-coding-agent": "^0.70.0",
    "@mariozechner/pi-tui": "^0.70.0",
    "@sinclair/typebox": "^0.34.49",
    "@wterm/dom": "^0.1.9",
    "@xterm/headless": "^6.0.0",
    "better-result": "^2.8.2",
    "cli-table3": "^0.6.5",
    "jiti": "^2.6.1",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-unicode-sets-regex": "^7.28.6",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "javascript-obfuscator": "^5.4.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
