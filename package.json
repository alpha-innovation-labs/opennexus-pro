{
  "name": "nexus-tui-awesome",
  "private": true,
  "version": "0.2.16",
  "type": "module",
  "piConfig": {
    "name": "nexus",
    "configDir": ".nexus"
  },
  "scripts": {
    "generate:feature-flags": "node scripts/feature-flags/generateCompiledFeatureFlags.mjs",
    "build:binary": "npm run generate:feature-flags && node scripts/release/buildBinaryBundle.mjs",
    "build:release": "npm run build:binary",
    "dev": "tsx src/index.ts",
    "test": "tsx --test $(find test -name '*.test.ts' -print)"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.6.0",
    "@mariozechner/pi-agent-core": "^0.68.0",
    "@mariozechner/pi-ai": "^0.68.0",
    "@mariozechner/pi-coding-agent": "^0.68.0",
    "@mariozechner/pi-tui": "^0.68.0",
    "@sinclair/typebox": "^0.34.49",
    "@wterm/dom": "^0.1.9",
    "@xterm/headless": "^5.5.0",
    "better-result": "^2.8.2",
    "jiti": "^2.6.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-unicode-sets-regex": "^7.28.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "javascript-obfuscator": "^5.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
