    "pi-slash-usage": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-unicode-sets-regex": "^7.28.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
