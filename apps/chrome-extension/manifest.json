{
  "manifest_version": 3,
  "name": "Nexus Annotate",
  "version": "0.4.0",
  "description": "Visual annotation tool for Nexus coding agent",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": [
        "src/sidebar/sidebar.css",
        "src/content/styles/annotation-base.css",
        "src/content/styles/annotation-panel.css",
        "src/content/styles/annotation-notes.css",
        "src/content/styles/annotation-debug.css",
        "src/content/styles/annotation-responsive.css"
      ],
      "js": [
        "src/sidebar/sidebar.js",
        "src/content/00-boot.js",
        "src/content/01-message-handling.js",
        "src/content/02-launcher-preferences.js",
        "src/content/03-launcher-visibility.js",
        "src/content/04-activation.js",
        "src/content/05-ui-elements.js",
        "src/content/06-note-positioning.js",
        "src/content/07-note-card.js",
        "src/content/08-note-state.js",
        "src/content/09-drag-handlers.js",
        "src/content/10-selection-actions.js",
        "src/content/11-rendering.js",
        "src/content/12-events.js",
        "src/content/13-selection-data.js",
        "src/content/14-box-model.js",
        "src/content/15-accessibility.js",
        "src/content/16-key-styles.js",
        "src/content/17-css-variables.js",
        "src/content/18-prune-selections.js",
        "src/content/19-etch-mutations.js",
        "src/content/20-etch-session.js",
        "src/content/21-stylesheet-serialization.js",
        "src/content/22-stylesheet-diff.js",
        "src/content/23-style-attribute-diff.js",
        "src/content/24-dom-changes.js",
        "src/content/25-etch-screenshots.js",
        "src/content/26-screenshots.js",
        "src/content/27-submission.js",
        "src/content/28-startup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidebar/sidebar.css",
        "src/content/styles/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle element picker"
    }
  },
  "action": {
    "default_title": "Nexus Annotate",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
