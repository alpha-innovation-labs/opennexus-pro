{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@nexus/observability/*": [
				"../../observability/src/*"
			],
			"@nexus/observability": [
				"../../observability/src/index.ts"
			],
			"@nexus/pi-platform/*": [
				"../../pi-platform/src/*"
			],
			"@nexus/pi-platform": [
				"../../pi-platform/src/index.ts"
			],
			"@nexus/runtime/*": [
				"../../nexus-runtime/src/*"
			],
			"@nexus/runtime": [
				"../../nexus-runtime/src/index.ts"
			],
			"@nexus/tui-kit/*": [
				"../../tui-kit/src/*"
			],
			"@nexus/tui-kit": [
				"../../tui-kit/src/index.ts"
			],
			"@extensions/rtk/*": [
				"../rtk/src/*"
			],
			"@extensions/rtk": [
				"../rtk/src/index.ts"
			],
			"@extensions/slash-menu/*": [
				"../slash-menu/src/*"
			],
			"@extensions/tron/colors/*": [
				"./src/colors/*"
			],
			"@extensions/tron/compact-tool-lines/types": [
				"./src/compact-tool-lines/types.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
