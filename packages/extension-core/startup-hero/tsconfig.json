{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@nexus/observability/*": [
				"../../observability/src/*"
			],
			"@nexus/observability": [
				"../../observability/src/index.ts"
			],
			"@nexus/runtime/*": [
				"../../nexus-runtime/src/*"
			],
			"@nexus/runtime": [
				"../../nexus-runtime/src/index.ts"
			],
			"@nexus/feature-flags/*": [
				"../../feature-flags/src/*"
			],
			"@nexus/feature-flags": [
				"../../feature-flags/src/index.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
