{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@nexus/runtime/*": [
				"../../nexus-runtime/src/*"
			],
			"@nexus/runtime": [
				"../../nexus-runtime/src/index.ts"
			],
			"@nexus/tui-kit/*": [
				"../../tui-kit/src/*"
			],
			"@nexus/tui-kit": [
				"../../tui-kit/src/index.ts"
			],
			"@nexus/pi-platform/*": [
				"../../pi-platform/src/*"
			],
			"@nexus/pi-platform": [
				"../../pi-platform/src/index.ts"
			],
			"@extensions/slash-menu/*": [
				"../slash-menu/src/*"
			],
			"@extensions/slash-menu": [
				"../slash-menu/src/index.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
